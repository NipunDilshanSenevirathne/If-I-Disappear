flowchart LR
  LEAVER["«actor»<br/><b>Person leaving</b><br/>Nirmala, going to work abroad<br/>(or into hospital)"]:::actor
  STAYING["«actor»<br/><b>Person staying</b><br/>Sunil, and other adults<br/>who take tasks over"]:::actor2
  VISITOR["«actor»<br/><b>Visitor or judge</b><br/>tries a sample family"]:::actor3

  subgraph SYS["If I Disappear"]
    direction TB
    subgraph CAP["Capture and check"]
      direction TB
      UC1(["Start a household: who leaves, when, for how long"]):::person
      UC2(["Add what you know: talk, photograph, upload, type, or a short form"]):::person
      UC3(["Review facts: accept, edit, reject or dispute"]):::person
      INC1(["Remove secrets before anything is stored"]):::guard
      INC2(["Check every quote word for word"]):::code
    end
    subgraph SEE["See and decide"]
      direction TB
      UC4(["See what stops, on which date, and why"]):::output
      UC5(["Read what nobody said; answer questions in place"]):::output
      UC6(["Ask what if: someone else away, a phone missing, a longer absence"]):::code
      UC7(["Get the smallest plan for the time left"]):::code
      UC8(["Mark a step done, saying how you know"]):::person
    end
    subgraph HAND["Hand over"]
      direction TB
      UC9(["Print the Continuity Card"]):::output
      UC10(["Send a private, revocable link per person"]):::person
      UC11(["Open my part of the card on my own phone"]):::person
      UC12(["Practise a task out loud or by typing"]):::ai
    end
    subgraph TRY["Try and verify"]
      direction TB
      UC13(["Open a private copy of a sample family"]):::person
      UC14(["See how it was worked out, and the evaluation"]):::code
      UC15(["Watch the free AI allowance, live"]):::ai
    end
  end

  GEM["«system actor»<br/><b>Gemini 3.8 Flash<br/>Gemini 3.5 and 3.1 Flash-Lite<br/>Gemma 4 31B</b><br/>listen, read, extract, review, grade"]:::gem
  LIVE["«system actor»<br/><b>Gemini 3.8 Live</b><br/>spoken practice partner"]:::gem

