# Local settings for the API. Copy to services/api/.env (git-ignored); `make api` and
# `make serve` load it. Nothing here is required: without a key the app runs as an offline demo.

# Gemini (https://aistudio.google.com/apikey). A free key works. With a key, AI_MODE defaults to live.
GEMINI_API_KEY=
# AI_MODE=fixture            # force offline replay even with a key

# The free-tier model router (docs/FREE_TIER.md). "paid" if your key is on a paid plan.
QUOTA_TIER=free
# AI_CALLS_PER_VISITOR=40    # a fair daily share per visitor (0 = no limit)
# QUOTA_LIMITS='{"gemini-3.8-flash": {"rpm": 5, "tpm": 250000, "rpd": 20}}'
# Each job's line of models, best first ("keep=N" leaves N daily requests for other jobs).
# Keep the quotes: the values contain spaces.
# AI_CHAIN_LISTENER="gemini-3.8-flash:keep=8, gemini-3.5-flash-lite, gemini-3.1-flash-lite"
# AI_CHAIN_READER="gemini-3.8-flash:keep=8, gemini-3.5-flash-lite:keep=200, gemini-3.1-flash-lite:keep=200, gemma-4-31b-it"
# AI_CHAIN_EXTRACTOR="gemini-3.8-flash:keep=8, gemini-3.5-flash-lite:keep=200, gemini-3.1-flash-lite:keep=200, gemma-4-31b-it"
# AI_CHAIN_CHALLENGER="gemini-3.8-flash, gemini-3.5-flash-lite:keep=200, gemini-3.1-flash-lite:keep=200, gemma-4-31b-it"
# AI_CHAIN_GRADER="gemini-3.5-flash-lite:keep=200, gemini-3.1-flash-lite:keep=200, gemma-4-31b-it, gemini-3.8-flash:keep=8"
# MODEL_LIVE=gemini-3.8-live # spoken practice

# Or use Vertex AI instead of an API key (spoken practice needs the API key):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global

# Storage: memory (default, lost on restart) or firestore (needs gcloud auth application-default login)
STORE=memory
# UPLOAD_BUCKET=your-bucket   # else uploads go to services/api/.data

# Who is calling: dev (default locally), session (signed visitor sessions) or firebase
AUTH_MODE=dev
# SESSION_SECRET=any-long-random-string   # required for AUTH_MODE=session

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
